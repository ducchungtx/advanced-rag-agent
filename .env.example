# Copy to .env and fill in values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# --- App ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Google Gemini ---
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-2

# --- Vector store ---
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
# Khi dùng docker-compose chromadb service:
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Redis (memory / cache — phase 2) ---
REDIS_URL=redis://localhost:6379/0

# --- RAG ---
# Văn bản pháp luật: ~800–1200 + overlap ~150–250 thường ổn;
# quan trọng hơn là cắt theo Điều/Khoản (xem LEGAL_SEPARATORS trong ingest.py).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
# Thư mục nguồn: hỗ trợ .pdf, .docx, .doc (đệ quy)
DATA_DIR=./data/docs
TEMPERATURE=0.0
